# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0
exclude:
  - "**/*_test.py"
  - "tests/"
  - "src/evaluator/tests/"
ignore:
  python/PT:
    - "src/evaluator/main.py":
        reason: "CLI input is trusted"
        expires: "2099-01-01T00:00:00.000Z"
    - "src/preprocessors/podcast_transcript_to_json.py":
        reason: "CLI input is trusted"
        expires: "2099-01-01T00:00:00.000Z"